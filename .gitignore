cat << 'EOF' > .gitignore
# Python environments & cache
venv/
.venv/
__pycache__/
*.pyc
*.zip

# Mac OS files
__MACOSX/
.DS_Store

# Data & Databases
data/
data/raw_pdfs/
data/chroma_db/
data/chroma_db_*
data/active_db.json
data/processed/
data/evaluation/
temp_ota_update.zip
chroma_db.zip

# Model weights & binaries
models/*.gguf
models/*.bin
models/deberta_aquaculture_router/

# Evaluation sheets and query workbooks
messy_query_excelsheets/
real_life_messy_queries/
*.xlsx
*.xls

# Test result folders and execution traces
24OCT_real_life_query_test_results/
25OCT_after-stresstest-correction*/
test_results/
*.jsonl
blind_eval_results_*.json

# Audio cache
temp_audio/
temp_16khz_mono.wav

# OS-Specific Compiled Binaries
bin/

# Local Test Outputs, Spreadsheets, & Logs
retrieval_output.txt
*.xlsx
*.csv
EOF
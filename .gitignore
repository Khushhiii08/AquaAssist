cat << 'EOF' > .gitignore
# Python environments & cache
venv/
.venv/
__pycache__/
*.pyc

# Mac OS files
__MACOSX/
.DS_Store

# Data & Databases
data/
data/raw_pdfs/
data/chroma_db/
data/chroma_db_*
data/active_db.json
data/processed/
data/evaluation/
temp_ota_update.zip
chroma_db.zip

# Model weights & binaries
models/*.gguf
models/*.bin
models/deberta_aquaculture_router/

# Audio cache
temp_audio/
temp_16khz_mono.wav

# OS-Specific Compiled Binaries
bin/

# Local Test Outputs, Spreadsheets, & Logs
retrieval_output.txt
*.xlsx
*.csv
EOF